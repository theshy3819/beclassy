---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';
---

<Base lang="ko" path="/" title="페이지를 찾을 수 없습니다 | 비클래시 BECLASSY" description="요청하신 페이지를 찾을 수 없습니다.">
  <section class="page-hero" data-theme="dark">
    <div class="page-hero__inner container">
      <p class="label label--line">404</p>
      <h1 class="display">NOT FOUND</h1>
      <p class="kr-title kr-title--sm">요청하신 페이지를 찾을 수 없습니다.</p>
      <p><a class="btn btn--light" href={href('ko', '/')}>메인으로</a></p>
    </div>
  </section>
</Base>
